# Ollama (локальная модель)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Groq API (глубокий анализ)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_REQUEST_LIMIT=14000

# YandexGPT
YC_FOLDER_ID=
YC_KEY_PATH=./yandex_key.json
YANDEX_MODEL=yandexgpt/latest
YANDEX_DAILY_TOKEN_LIMIT=50000

# База данных
DATABASE_URL=sqlite:///./data/vacancies.db

# AI router
AI_CACHE_TTL_DAYS=30
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0
USAGE_WARN_THRESHOLD=0.8

# Путь к резюме в Markdown (локально)
RESUME_PATH=~/Documents/resume.md

# Контакты для подписи в сопроводительном письме (подставляются автоматически)
CONTACT_PHONE=+79778208218
CONTACT_TELEGRAM=addito
CONTACT_LINKEDIN=https://www.linkedin.com/in/addito

# hh.ru OAuth (опционально)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_RESUME_ID=
